{
  "name": "gastos-hogar",
  "private": true,
  "type": "module",
  "description": "Finanzas del hogar: app web estática que guarda los datos en OneDrive.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "tamano": "node herramientas/verificar-tamano.js",
    "e2e": "playwright test",
    "version": "node herramientas/verificar-version.js",
    "verificar": "npm run lint && npm test && npm run tamano && npm run e2e",
    "dev": "python -m http.server 8080 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "vue": "^3.5.42"
  }
}
